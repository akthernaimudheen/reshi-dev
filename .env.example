# Canonical origin — used for metadataBase, sitemap, robots, canonical URLs
# and JSON-LD. No trailing slash. On Vercel set this to the deployment URL,
# e.g. https://reshi-dev.vercel.app, and to the real domain at launch.
NEXT_PUBLIC_SITE_URL=https://reshi.ai

# Search engine indexing. Anything other than exactly "true" keeps the whole
# site noindex — the safe default for preview deployments. Set to true only on
# the production domain, once the content is real.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Contact and newsletter delivery. All three are required; with any missing the
# forms return 503 rather than pretending a message was sent.
# The sender must use a domain verified in Resend. See docs/email-setup.md.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Reshi AI <noreply@reshi.ai>"
CONTACT_TO_EMAIL=hello@reshi.ai
